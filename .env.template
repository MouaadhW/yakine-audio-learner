# example .env file variables

API_URL= # backend api url
MMKV_ENCRYPTION_KEY= # random key for encrypted local metadata storage

# backend (backend/.env)
PORT=8000
DATABASE_URL=
JWT_SECRET=
REFRESH_TOKEN_SECRET=
CORS_ORIGIN=*

# storage (required for teacher composer uploads + generated audio)
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=yakine-audio-files
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# elevenlabs (required for AI text-to-speech)
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_FR=
ELEVENLABS_VOICE_AR=
TTS_REQUEST_TIMEOUT_MS=45000
TEACHER_COMPOSER_MAX_CHARS=12000
