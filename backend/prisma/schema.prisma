generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  name             String
  password         String
  role             Role               @default(STUDENT)
  subscriptionTier SubscriptionTier   @default(FREE)
  language         String             @default("fr")
  banned           Boolean            @default(false)
  currentSessionId String?
  lastLoginAt      DateTime?
  emailVerified    Boolean            @default(false)
  emailVerifiedAt  DateTime?
  createdAt        DateTime        @default(now())
  educationLevel   EducationLevel?
  grade            Int?
  universityYear   Int?
  stream           Stream?
  lawRegion        LawRegion?
  lawUniversity    String?
  lawMajor         LawMajor?
  lawAcademicLevel LawAcademicLevel?

  lessons              Lesson[]                @relation("TeacherLessons")
  passwordResetTokens  PasswordResetToken[]
  emailVerifTokens     EmailVerificationToken[]
  audioGenerationJobs AudioGenerationJob[] @relation("TeacherAudioGenerationJobs")
  progress           Progress[]
  downloads          Download[]
  refreshTokens      RefreshToken[]
  teacherScopes      TeacherScope[]
  teacherLawSubjects TeacherLawSubject[]
}

enum LawRegion {
  TUNIS
  SOUSSE
  SFAX
  JENDOUBA
  KAIROUAN
  GABES
  NABEUL
  BIZERTE
}

enum LawMajor {
  DROIT_PRIVE
  DROIT_PUBLIC
}

enum LawAcademicLevel {
  L1
  L2
  L3
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum EducationLevel {
  HIGH_SCHOOL
  UNIVERSITY
}

model Subject {
  id               String             @id @default(cuid())
  nameEn           String
  nameFr           String
  slugEn           String             @default("")
  slugFr           String             @default("")
  stream           Stream
  icon             String             @default("📚")
  color            String             @default("#6C63FF")
  educationLevel   EducationLevel     @default(HIGH_SCHOOL)
  grade            Int?
  universityYear   Int?
  programType      ProgramType        @default(BAC)
  contentTier      ContentTier        @default(FREE_GLOBAL)
  lawUniversity    String?
  lawAcademicLevel LawAcademicLevel?
  lawMajor         LawMajor?
  semester         Int?
  chapters         Chapter[]
  teacherLawSubjects TeacherLawSubject[]
}

enum ProgramType {
  BAC
  LAW
}

enum ContentTier {
  FREE_GLOBAL
  PREMIUM_SCOPED
}

enum Stream {
  SCIENTIFIC
  LITERARY
  ECONOMIC
  TECHNICAL
  LAW
}

model Chapter {
  id        String   @id @default(cuid())
  nameEn    String
  nameFr    String
  sortOrder Int      @default(0)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([subjectId])
}

model Lesson {
  id          String          @id @default(cuid())
  titleEn     String
  titleFr     String
  audioUrl    String
  audioUrlEn  String?
  audioUrlFr  String?
  audioUrlAr  String?
  scriptEn    String          @db.Text
  scriptFr    String          @db.Text
  scriptAr    String?         @db.Text
  transcriptEn String?        @db.Text
  transcriptFr String?        @db.Text
  transcriptAr String?        @db.Text
  duration    Int
  sortOrder   Int             @default(0)
  status      LessonStatus    @default(PUBLISHED)
  audience    LessonAudience  @default(FREE)
  defaultAudioLanguage ComposerLanguage  @default(FR)
  audioSourceType     LessonAudioSourceType @default(LEGACY)
  isTeacherComposer   Boolean         @default(false)
  composerAutoPublish Boolean         @default(false)
  generationRequestedAt DateTime?
  generatedAt          DateTime?
  chapterId   String
  chapter     Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User            @relation("TeacherLessons", fields: [teacherId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  progress    Progress[]
  downloads   Download[]
  generationJobs AudioGenerationJob[]

  @@index([chapterId])
  @@index([teacherId])
  @@index([chapterId, status])
}

enum LessonAudience {
  FREE
  PREMIUM
}

enum ComposerLanguage {
  EN
  FR
  AR
}

enum LessonAudioSourceType {
  LEGACY
  MANUAL_UPLOAD
  MANUAL_RECORDING
  AI_TTS
}

enum TtsProvider {
  ELEVENLABS
}

enum AudioGenerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}

model AudioGenerationJob {
  id                 String               @id @default(cuid())
  lessonId           String
  lesson             Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  teacherId          String
  teacher            User                 @relation("TeacherAudioGenerationJobs", fields: [teacherId], references: [id], onDelete: Cascade)
  provider           TtsProvider          @default(ELEVENLABS)
  status             AudioGenerationStatus @default(QUEUED)
  requestedLanguages Json
  voiceSelection     Json?
  errorMessage       String?
  attemptCount       Int                  @default(0)
  requestedAt        DateTime             @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([lessonId])
  @@index([status, createdAt])
}

model TeacherLawSubject {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId])
}

enum LessonStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

model Progress {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String
  position   Int      @default(0)
  completed  Boolean  @default(false)
  updatedAt  DateTime @default(now()) @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([updatedAt])
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  localPath String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  type      String   @default("info")
  active    Boolean  @default(true)
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  createdAt DateTime @default(now())
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String   @default("")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model TeacherScope {
  id             String         @id @default(cuid())
  teacherId      String
  teacher        User           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  educationLevel EducationLevel
  grade          Int?
  universityYear Int?
  stream         Stream
  createdAt      DateTime       @default(now())

  @@unique([teacherId, educationLevel, grade, universityYear, stream])
}
