generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  password  String
  role      Role       @default(STUDENT)
  language  String     @default("fr")
  banned    Boolean    @default(false)
  lastLoginAt DateTime?
  createdAt DateTime   @default(now())

  lessons    Lesson[]   @relation("TeacherLessons")
  progress   Progress[]
  downloads  Download[]
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model Subject {
  id       String    @id @default(cuid())
  nameEn   String
  nameFr   String
  slugEn   String    @default("")
  slugFr   String    @default("")
  stream   Stream
  icon     String    @default("📚")
  color    String    @default("#6C63FF")
  chapters Chapter[]
}

enum Stream {
  SCIENTIFIC
  LITERARY
  ECONOMIC
  TECHNICAL
}

model Chapter {
  id        String   @id @default(cuid())
  nameEn    String
  nameFr    String
  sortOrder Int      @default(0)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id          String       @id @default(cuid())
  titleEn     String
  titleFr     String
  audioUrl    String
  scriptEn    String       @db.Text
  scriptFr    String       @db.Text
  duration    Int
  sortOrder   Int          @default(0)
  status      LessonStatus @default(PUBLISHED)
  chapterId   String
  chapter     Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User         @relation("TeacherLessons", fields: [teacherId], references: [id])
  createdAt   DateTime     @default(now())

  progress    Progress[]
  downloads   Download[]
}

enum LessonStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

model Progress {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String
  position   Int      @default(0)
  completed  Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  localPath String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  type      String   @default("info")
  active    Boolean  @default(true)
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  createdAt DateTime @default(now())
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String   @default("")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
